# Azure Configuration (Dummy - Replace with your actual values)
AZURE_SUBSCRIPTION_ID=your-subscription-id-here
AZURE_RESOURCE_GROUP=your-resource-group-name
AZURE_STORAGE_ACCOUNT=yourstorageaccountname
AZURE_STORAGE_KEY=your-storage-key-here

# ADLS Paths (Dummy paths - Update with your actual paths)
ADLS_ACCOUNT_NAME=dummy_adls_account
ADLS_CONTAINER=dummy_container
ADLS_STAGING_PATH=/staging/weather
ADLS_BRONZE_PATH=/bronze/weather
ADLS_SILVER_PATH=/silver/weather
ADLS_GOLD_PATH=/gold/weather
ADLS_ARCHIVE_PATH=/archive/weather

# Databricks Configuration
DATABRICKS_HOST=https://adb-dummy-workspace-id.azuredatabricks.net
DATABRICKS_TOKEN=dummy-databricks-token
DATABRICKS_CLUSTER_ID=dummy-cluster-id

# Database Configuration
DB_SERVER=dummy-sql-server.database.windows.net
DB_NAME=weather_db
DB_USER=dummy_user
DB_PASSWORD=dummy_password

# Key Vault
KEY_VAULT_NAME=dummy-keyvault-name

# API Configuration
WEATHER_API_KEY=dummy-api-key-for-weather-service
API_RATE_LIMIT=100
API_TIMEOUT_SECONDS=30

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Application Insights (Optional)
APPINSIGHTS_INSTRUMENTATION_KEY=dummy-instrumentation-key

# Environment
ENVIRONMENT=development  # development, staging, production
